<h1>New dish for <%= @restaurant.name %></h1>

<%= form_with model: [@restaurant, @menu_item] do |form| %>
  <% if @menu_item.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(@menu_item.errors.count, "error") %> prevented this dish from being saved:</h2>
      <ul>
        <% @menu_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description, rows: 3 %>
  </div>

  <div>
    <%= form.label :price, "Price (€)" %>
    <%= form.number_field :price, step: "0.01", min: "0" %>
  </div>

  <div>
    <%= form.check_box :available %>
    <%= form.label :available, "Available" %>
  </div>

  <%= form.submit "Add dish" %>

<% end %>

<p><%= link_to "Cancel", @restaurant %></p>
