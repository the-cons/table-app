<h1><%= @restaurant.name %> <i>(<%= pluralize(@menu_items.size, "dish") %>)</i></h1>

<% if @restaurant.phone.present? %>
  <p>Phone: <%= @restaurant.phone %></p>
<% end %>

<h2>Menu</h2>

<% if @menu_items.any? %>
  <table>
    <% @menu_items.each do |item| %>
      <tr>
        <td><%= item.name %></td>
        <td><%= number_to_currency(item.price, unit: "€", format: "%n %u") %></td>
        <td><%= link_to "Edit", edit_restaurant_menu_item_path(@restaurant, item) %></td>
        <td>
          <%= button_to "Delete", restaurant_menu_item_path(@restaurant, item),
                        method: :delete,
                        form: { data: { turbo_confirm: "Are you sure?" } } %>
        </td>
      </tr>
    <% end %>
  </table>
<% else %>
  <p>No menu yet.</p>
<% end %>

<p><%= link_to "Add a dish", new_restaurant_menu_item_path(@restaurant) %></p>
<p><%= link_to "<- All restaurants", restaurants_path %></p>
